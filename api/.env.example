# ---- Servidor ----
# Porta local em que o Express escuta (o Caddy faz o proxy para ela).
PORT=3334

# Token obrigatorio enviado pelo cliente no header X-API-Token.
# Minimo 16 caracteres. Gere um com: openssl rand -hex 32
API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Confia no header X-Forwarded-For para rate limit por IP.
# Deixe true quando estiver atras do Caddy; false se expuser direto.
TRUST_PROXY=true

# ---- Banco ----
# Caminho do arquivo SQLite, relativo a raiz do projeto ou absoluto.
DB_PATH=data/gastos.db

# ---- Ollama (LLM local, sem API paga) ----
OLLAMA_URL=http://localhost:11434
# Modelo usado na extracao. Alternativa mais rapida em CPU: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b
# Modelo que escreve o conselho financeiro (/api/consultor). Vazio = usa o
# OLLAMA_MODEL acima. O veredito e as contas NAO saem do modelo: sao
# calculados em JavaScript, e o modelo so redige a justificativa. Trocar para
# qwen2.5:7b melhora o texto e custa ~2x o tempo de geracao.
OLLAMA_MODEL_CONSELHO=

# Timeout da chamada de inferencia, em milissegundos.
OLLAMA_TIMEOUT_MS=90000

# ---- Datas ----
# Fuso usado para decidir o que e "hoje" e "ontem".
TZ_APP=America/Sao_Paulo

# ---- Rate limit ----
# Janela e numero maximo de requisicoes por IP dentro da janela.
RATE_LIMIT_JANELA_MS=60000
RATE_LIMIT_MAX=60

# ---- CORS ----
# Origens de navegador autorizadas a chamar esta API, separadas por virgula.
# Preencha com a URL do frontend na Vercel (sem barra no fim). Ex:
# CORS_ORIGENS=https://gastos.vercel.app,https://gastos-git-main-seu-user.vercel.app
CORS_ORIGENS=
