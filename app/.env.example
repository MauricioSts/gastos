# Deixe true (ou não defina) para rodar com os dados de demonstração que
# reproduzem as telas de referência. Só troque para false quando o backend
# estiver acessível pela internet.
VITE_USAR_MOCK=true

# Base da API. Sem barra no fim. Em produção precisa ser HTTPS: a Vercel serve
# o app em HTTPS e o navegador bloqueia chamada para http:// a partir dele.
# Ex: https://gastos.seu-dominio.com
VITE_API_URL=

# Token exigido pelo backend no header X-API-Token.
# ATENÇÃO: tudo que é VITE_* vai para o bundle e fica visível para qualquer
# pessoa que abrir o app. Este token protege contra varredura, não contra
# alguém que abra o DevTools.
VITE_API_TOKEN=
